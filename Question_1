#include <iostream>
using namespace std;

const char* str_match(const char* s1, const char* s2)
{
    if (s2[0] == '\0')
    {
        return s1;
    }

    for (int i = 0; s1[i] != '\0'; i++)
    {
        int j = 0;

        for (; s2[j] != '\0'; j++)
        {
            if (s1[i + j] == '\0' || s1[i + j] != s2[j])
            {
                break;
            }
        }

        if (s2[j] == '\0')
        {
            return &s1[i];
        }
    }

    return nullptr;
}

int main()
{
    const char* s1 = "Hello_World";
    const char* s2 = "World";

    const char* result = str_match(s1, s2);

    if (result != nullptr)
    {
        cout << "Found: " << result << endl;
        cout << "Index: " << result - s1 << endl;
    }
    else
    {
        cout << "Not found" << endl;
    }

    return 0;
}
